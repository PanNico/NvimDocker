# Builds on top of the base image created with Dockerfile
FROM ubuntu_t1

WORKDIR /root

# Additional system packages
RUN apt update && apt install -y clangd clang-format \
    && rm -rf /var/lib/apt/lists/*

# Custom Neovim configuration (overrides base config, preserves lazy.nvim)
COPY Config/Custom1/nvim /root/.config/nvim

# Ensure plugins directory exists for lazy spec files
RUN mkdir -p /root/.config/nvim/lua/plugins

# Re-sync plugins with updated configuration from user's spec
RUN ${INSTALL_PREFIX}/bin/nvim --headless +Lazy! sync +qa || true

# Personal scripts
COPY MyScripts /root/scripts

# Git configuration
ARG GIT_EMAIL="pancheri.nicola@gmail.com"
ARG GIT_NAME="Nicola Pancheri"
RUN git config --global user.email "${GIT_EMAIL}" \
    && git config --global user.name "${GIT_NAME}"

CMD ["/bin/bash"]
