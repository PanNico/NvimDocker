# Builds on top of the base image created with Dockerfile
# Change the image name below to match yours
FROM ubuntu_t1

WORKDIR /root

# Additional system packages
RUN apt update && apt install -y \
    clangd clang-format \
    && rm -rf /var/lib/apt/lists/*

# LSP config and linter plugins
RUN git clone --depth 1 https://github.com/neovim/nvim-lspconfig.git \
    ~/.config/nvim/pack/nvim/start/nvim-lspconfig
RUN git clone --depth 1 https://github.com/dense-analysis/ale.git \
    ~/.local/share/nvim/site/pack/git-plugins/start/ale

# Custom Neovim configuration (overrides base config)
COPY Config/Custom1/nvim /root/.config/nvim

# Install plugins
RUN nvim --headless +PackerSync +qa || true

# Personal scripts
COPY MyScripts /root/MyScripts

# Git configuration
ARG GIT_EMAIL="pancheri.nicola@gmail.com"
ARG GIT_NAME="Nicola Pancheri"
RUN git config --global user.email "${GIT_EMAIL}" \
    && git config --global user.name "${GIT_NAME}"

CMD ["/bin/bash"]
